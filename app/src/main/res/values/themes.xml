<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OnTime" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ontime_primary</item>
        <item name="colorPrimaryDark">@color/ontime_primary_dark</item>
        <item name="colorAccent">@color/ontime_accent</item>
        <item name="android:statusBarColor">@color/ontime_primary_dark</item>
        <item name="android:windowBackground">@color/ontime_off_white</item>
    </style>

    <style name="Theme.OnTime.Splash">
        <item name="android:windowBackground">@color/ontime_primary</item>
        <item name="android:statusBarColor">@color/ontime_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen" tools:targetApi="34">false</item>
    </style>
</resources>
